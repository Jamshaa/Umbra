# Copy to .env (git-ignored, never commit values). See SECURITY.md.
# The model key travels only as an Authorization header, never in
# logs, errors, receipts or files.
MODEL_API_KEY=<REPLACE-ME>
# Optional: OpenAI-compatible endpoint for local models.
# Default: https://api.meta.ai/v1
# Plaintext http is accepted only on loopback (the key travels as an
# Authorization header on every call); https is required elsewhere.
MODEL_BASE_URL=https://api.meta.ai/v1
# Optional. Default: muse-spark-1.3
MODEL_NAME=muse-spark-1.3
# Optional: fixed seed for reproducible runs (0 = server decides).
MODEL_SEED=
